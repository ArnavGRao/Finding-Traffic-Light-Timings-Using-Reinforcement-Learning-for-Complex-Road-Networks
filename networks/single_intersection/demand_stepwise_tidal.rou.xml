<?xml version="1.0" encoding="UTF-8"?>
<!-- Three 20-minute periods: balanced, north/south peak, then east/west peak. -->
<routes>
    <route id="route_ns" edges="n_t t_s"/>
    <route id="route_nw" edges="n_t t_w"/>
    <route id="route_ne" edges="n_t t_e"/>
    <route id="route_we" edges="w_t t_e"/>
    <route id="route_wn" edges="w_t t_n"/>
    <route id="route_ws" edges="w_t t_s"/>
    <route id="route_ew" edges="e_t t_w"/>
    <route id="route_en" edges="e_t t_n"/>
    <route id="route_es" edges="e_t t_s"/>
    <route id="route_sn" edges="s_t t_n"/>
    <route id="route_se" edges="s_t t_e"/>
    <route id="route_sw" edges="s_t t_w"/>

    <flow id="n_straight_1" route="route_ns" begin="0" end="1200" vehsPerHour="400" departLane="best" departSpeed="max"/>
    <flow id="n_right_1" route="route_nw" begin="0" end="1200" vehsPerHour="100" departLane="best" departSpeed="max"/>
    <flow id="n_left_1" route="route_ne" begin="0" end="1200" vehsPerHour="100" departLane="best" departSpeed="max"/>
    <flow id="w_straight_1" route="route_we" begin="0" end="1200" vehsPerHour="400" departLane="best" departSpeed="max"/>
    <flow id="w_right_1" route="route_wn" begin="0" end="1200" vehsPerHour="100" departLane="best" departSpeed="max"/>
    <flow id="w_left_1" route="route_ws" begin="0" end="1200" vehsPerHour="100" departLane="best" departSpeed="max"/>
    <flow id="e_straight_1" route="route_ew" begin="0" end="1200" vehsPerHour="400" departLane="best" departSpeed="max"/>
    <flow id="e_right_1" route="route_es" begin="0" end="1200" vehsPerHour="100" departLane="best" departSpeed="max"/>
    <flow id="e_left_1" route="route_en" begin="0" end="1200" vehsPerHour="100" departLane="best" departSpeed="max"/>
    <flow id="s_straight_1" route="route_sn" begin="0" end="1200" vehsPerHour="400" departLane="best" departSpeed="max"/>
    <flow id="s_right_1" route="route_se" begin="0" end="1200" vehsPerHour="100" departLane="best" departSpeed="max"/>
    <flow id="s_left_1" route="route_sw" begin="0" end="1200" vehsPerHour="100" departLane="best" departSpeed="max"/>

    <flow id="n_straight_2" route="route_ns" begin="1200" end="2400" vehsPerHour="600" departLane="best" departSpeed="max"/>
    <flow id="n_right_2" route="route_nw" begin="1200" end="2400" vehsPerHour="150" departLane="best" departSpeed="max"/>
    <flow id="n_left_2" route="route_ne" begin="1200" end="2400" vehsPerHour="150" departLane="best" departSpeed="max"/>
    <flow id="w_straight_2" route="route_we" begin="1200" end="2400" vehsPerHour="165" departLane="best" departSpeed="max"/>
    <flow id="w_right_2" route="route_wn" begin="1200" end="2400" vehsPerHour="42" departLane="best" departSpeed="max"/>
    <flow id="w_left_2" route="route_ws" begin="1200" end="2400" vehsPerHour="43" departLane="best" departSpeed="max"/>
    <flow id="e_straight_2" route="route_ew" begin="1200" end="2400" vehsPerHour="165" departLane="best" departSpeed="max"/>
    <flow id="e_right_2" route="route_es" begin="1200" end="2400" vehsPerHour="42" departLane="best" departSpeed="max"/>
    <flow id="e_left_2" route="route_en" begin="1200" end="2400" vehsPerHour="43" departLane="best" departSpeed="max"/>
    <flow id="s_straight_2" route="route_sn" begin="1200" end="2400" vehsPerHour="600" departLane="best" departSpeed="max"/>
    <flow id="s_right_2" route="route_se" begin="1200" end="2400" vehsPerHour="150" departLane="best" departSpeed="max"/>
    <flow id="s_left_2" route="route_sw" begin="1200" end="2400" vehsPerHour="150" departLane="best" departSpeed="max"/>

    <flow id="n_straight_3" route="route_ns" begin="2400" end="3600" vehsPerHour="165" departLane="best" departSpeed="max"/>
