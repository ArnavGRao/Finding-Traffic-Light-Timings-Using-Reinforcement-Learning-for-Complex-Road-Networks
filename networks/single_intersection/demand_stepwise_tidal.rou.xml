    <flow id="w_left_3" route="route_ws" begin="2400" end="3600" vehsPerHour="150" departLane="best" departSpeed="max"/>
    <flow id="e_straight_3" route="route_ew" begin="2400" end="3600" vehsPerHour="600" departLane="best" departSpeed="max"/>
    <flow id="e_right_3" route="route_es" begin="2400" end="3600" vehsPerHour="150" departLane="best" departSpeed="max"/>
